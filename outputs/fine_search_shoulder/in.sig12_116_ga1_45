# Fine Search: Ga1=0.45, sigma12=1.16x
# Ga1-Ga1 sigma = 2.9700 A (x1.1)
# Ga2-Ga2 sigma = 2.4300 A (x0.9)
# Ga1-Ga2 sigma = 3.1320 A (x1.16)
# Epsilon = 0.4300 kcal/mol

package         kokkos neigh full newton off

units           real
atom_style      atomic
boundary        p p p

read_data       inputs/data.ga_base_2types

set             group all type 1
set             group all type/fraction 2 0.55 18005

pair_style      lj/cut/kk 12.0
pair_coeff      1 1 0.4300 2.9700
pair_coeff      2 2 0.4300 2.4300
pair_coeff      1 2 0.4300 3.1320

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
velocity        all create 423.15 18005 dist gaussian

thermo          1000
thermo_style    custom step temp press density

minimize        1.0e-4 1.0e-6 10000 100000
reset_timestep  0

timestep        2.0
fix             nvt all nvt temp 423.15 423.15 100.0
run             50000
unfix           nvt
reset_timestep  0

fix             nvt all nvt temp 423.15 423.15 100.0
compute         myrdf all rdf 200 1 1 2 2 1 2 cutoff 12.0
fix             rdfout all ave/time 100 1000 100000 c_myrdf[*] file outputs/fine_search_shoulder/out_sig12_116_ga1_45.rdf mode vector

run             100000
