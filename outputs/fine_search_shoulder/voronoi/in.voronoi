# Voronoi Analysis Run
# Best fit: Ga1=0.45, sigma12=1.17x
# Ga1 (Type 1) = Large sigma = 45%
# Ga2 (Type 2) = Small sigma = 55%
# Ga1-Ga1 sigma = 2.9700 A (x1.1)
# Ga2-Ga2 sigma = 2.4300 A (x0.9)
# Ga1-Ga2 sigma = 3.1590 A (x1.17)
# Epsilon = 0.4300 kcal/mol

package         kokkos neigh full newton off

units           real
atom_style      atomic
boundary        p p p

read_data       inputs/data.ga_base_2types

set             group all type 1
set             group all type/fraction 2 0.55 18015

pair_style      lj/cut/kk 12.0
pair_coeff      1 1 0.4300 2.9700
pair_coeff      2 2 0.4300 2.4300
pair_coeff      1 2 0.4300 3.1590

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
velocity        all create 423.15 18495 dist gaussian

thermo          1000
thermo_style    custom step temp press density

minimize        1.0e-4 1.0e-6 10000 100000
reset_timestep  0

# 平衡化
timestep        2.0
fix             nvt all nvt temp 423.15 423.15 100.0
run             50000
unfix           nvt
reset_timestep  0

# 本番: トラジェクトリ出力
fix             nvt all nvt temp 423.15 423.15 100.0

# LAMMPS dump形式 (.lammpstrj) - 全原子情報
dump            traj all custom 1000 outputs/fine_search_shoulder/voronoi/trajectory.lammpstrj id type x y z vx vy vz

# XYZ形式
dump            xyz all xyz 1000 outputs/fine_search_shoulder/voronoi/trajectory.xyz
dump_modify     xyz element Ga In

# RDF計算
compute         myrdf all rdf 200 1 1 2 2 1 2 cutoff 12.0
fix             rdfout all ave/time 100 1000 100000 c_myrdf[*] file outputs/fine_search_shoulder/voronoi/output.rdf mode vector

run             100000

# 最終構造を出力
write_data      outputs/fine_search_shoulder/voronoi/final_structure.data
write_dump      all custom outputs/fine_search_shoulder/voronoi/final_structure.lammpstrj id type x y z vx vy vz
