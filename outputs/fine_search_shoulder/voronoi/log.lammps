package kokkos
# Voronoi Analysis Run
# Best fit: Ga1=0.45, sigma12=1.17x
# Ga1-Ga1 sigma = 2.9700 A (x1.1)
# Ga2-Ga2 sigma = 2.4300 A (x0.9)
# Ga1-Ga2 sigma = 3.1590 A (x1.17)
# Epsilon = 0.4300 kcal/mol

package         kokkos neigh full newton off

units           real
atom_style      atomic
boundary        p p p

read_data       inputs/data.ga_base_2types
